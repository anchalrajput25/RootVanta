# install.sh / install.ps1 create .env with new secrets for Docker. For running
# without Docker, copy this to .env and change the secrets. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INCIDENT_AGENT_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Encrypts the monitoring tokens companies save. Back it up; if it changes, tokens must be saved again.
INCIDENT_AGENT_SECRET_KEY=change-me-too
INCIDENT_AGENT_TOKEN_TTL_MINUTES=60
# Without Docker, the API uses a local SQLite file by default:
# INCIDENT_AGENT_DATABASE_URL=sqlite:///./incident_agent.db

# Where people open the dashboard. Used for company sign-in (SSO) redirects and links in chat messages.
# INCIDENT_AGENT_PUBLIC_URL=http://localhost:3001

# Several companies on one server: refuse private network addresses in Settings.
# INCIDENT_AGENT_BLOCK_PRIVATE_URLS=1

# Each company connects its own monitoring in Settings > Monitoring. A single-company
# install can instead give everyone these shared connections:
# INCIDENT_AGENT_SHARED_CONNECTIONS=1
# INCIDENT_AGENT_PROMETHEUS_URL=http://localhost:9090
# INCIDENT_AGENT_LOKI_URL=http://localhost:3100
# INCIDENT_AGENT_JAEGER_URL=http://localhost:16686
# INCIDENT_AGENT_SHOP_URLS=checkout=http://localhost:8101,payments=http://localhost:8102,search=http://localhost:8103
# INCIDENT_AGENT_SHOP_TOKEN=demo-admin-token

# How long a fix is watched before the verdict (seconds)
# INCIDENT_AGENT_SETTLE_SECONDS=60
# INCIDENT_AGENT_VERIFY_WINDOW_SECONDS=600
# INCIDENT_AGENT_STAGE_WINDOW_SECONDS=120
# Let Claude rank causes too (needs pip install -e ".[ai]" and ANTHROPIC_API_KEY)
# INCIDENT_AGENT_USE_AI=1
